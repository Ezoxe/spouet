# Force LF line endings for all text files (target: Debian)
* text=auto eol=lf

# Binaries — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Windows-specific scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
