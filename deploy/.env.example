# Public hostname utilisé par Caddy pour TLS (ACME)
SPOUET_PUBLIC_HOSTNAME=spouet.local

# Postgres
POSTGRES_USER=spouet
POSTGRES_PASSWORD=changeme_long_random
POSTGRES_DB=spouet

# Redis
REDIS_PASSWORD=changeme_redis

# Backend
SPOUET_DATABASE_URL=postgresql+asyncpg://spouet:changeme_long_random@postgres:5432/spouet
SPOUET_REDIS_URL=redis://:changeme_redis@redis:6379/0
SPOUET_SECRET_KEY=replace_with_openssl_rand_hex_32
SPOUET_LOG_LEVEL=INFO
SPOUET_CORS_ORIGINS=https://spouet.local,tauri://localhost,http://localhost:5173

# Embedding model par défaut (doit être disponible sur au moins un node)
SPOUET_EMBEDDING_MODEL=nomic-embed-text
SPOUET_EMBEDDING_DIM=768

# Tools sandbox
SPOUET_TOOL_DEFAULT_MEM_LIMIT=256m
SPOUET_TOOL_DEFAULT_CPU_LIMIT=1.0
SPOUET_TOOL_DEFAULT_TIMEOUT_S=30

# Heartbeat node
SPOUET_NODE_OFFLINE_AFTER_S=30
