{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Spouet",
    "version": "0.1.0",
    "identifier": "com.spouet.desktop",
    "build": {
        "beforeDevCommand": "cd ../web && pnpm install --no-frozen-lockfile && pnpm dev",
        "beforeBuildCommand": "cd ../web && pnpm install --no-frozen-lockfile && pnpm build",
        "devUrl": "http://localhost:5173",
        "frontendDist": "../../web/build"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "Spouet",
                "width": 1100,
                "height": 760,
                "minWidth": 800,
                "minHeight": 600,
                "decorations": true,
                "transparent": false,
                "visible": true
            },
            {
                "label": "companion",
                "title": "Spouet Compagnon",
                "url": "/companion",
                "width": 460,
                "height": 600,
                "decorations": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "resizable": true,
                "shadow": true
            },
            {
                "label": "overlay",
                "title": "Spouet Overlay",
                "url": "/overlay",
                "width": 540,
                "height": 460,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "resizable": false,
                "shadow": false,
                "focus": false
            }
        ],
        "security": {
            "csp": "default-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss:"
        },
        "trayIcon": {
            "id": "spouet-tray",
            "iconPath": "icons/icon.png",
            "tooltip": "Spouet",
            "menuOnLeftClick": false
        }
    },
    "bundle": {
        "active": true,
        "targets": ["msi", "nsis"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.ico",
            "icons/icon.png"
        ],
        "windows": {
            "wix": {
                "language": "fr-FR"
            }
        }
    },
    "plugins": {
        "globalShortcut": { "all": true },
        "notification": { "all": true }
    }
}
